# ==============================================================================
# NEXUS RAG — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' and populate your sensitive API keys & endpoints.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM & EMBEDDING PROVIDERS (Phase 1)
# ------------------------------------------------------------------------------
# Set your OpenAI API key if using GPT-4o / text-embedding-3-small
OPENAI_API_KEY=

# Set your Anthropic API key if using Claude 3.5 Sonnet / Claude 3 Haiku
ANTHROPIC_API_KEY=

# Preferred LLM Provider: 'openai' | 'anthropic' | 'local'
# Default: 'openai' (automatically falls back to local deterministic mode if empty)
DEFAULT_LLM_PROVIDER=openai

# ------------------------------------------------------------------------------
# 2. EXTERNAL REST API INTEGRATION (Phase 2 - Agent Actions)
# ------------------------------------------------------------------------------
# Connect your external production API (e.g. Jira, Zendesk, Salesforce, or internal REST API)
# The agent will dispatch validated tool actions directly to this base URL with retries.
EXTERNAL_API_BASE_URL=

# Bearer Token / API Key for your external API
EXTERNAL_API_KEY=

# Timeout in seconds per external API request
EXTERNAL_API_TIMEOUT_SEC=5.0

# Number of automatic retries with exponential backoff for failed API requests
MAX_API_RETRIES=3

# ------------------------------------------------------------------------------
# 3. APPLICATION & STORAGE SETTINGS
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8080
STORAGE_DIR=./data_storage
SIMILARITY_THRESHOLD=0.35
MAX_UPLOAD_SIZE_BYTES=26214400
